<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Spectre.Console</id>
    <version>0.57.2</version>
    <authors>Patrik Svensson, Phil Scott, Nils Andresen, Cédric Luthi</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/spectreconsole/spectre.console</projectUrl>
    <description>A library that makes it easier to create beautiful console applications.</description>
    <releaseNotes>https://github.com/spectreconsole/spectre.console/releases</releaseNotes>
    <copyright>Patrik Svensson, Phil Scott, Nils Andresen, Cédric Luthi</copyright>
    <repository type="git" url="https://github.com/spectreconsole/spectre.console" commit="bbbb5729dde27b58deee44f447a788eea46ee451" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Spectre.Console.Ansi" version="0.57.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Spectre.Console.Ansi" version="0.57.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Spectre.Console.Ansi" version="0.57.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Spectre.Console.Ansi" version="0.57.2" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Bcl.TimeProvider" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>